---
import '../styles/tailwind.css';
import '../styles/site.css';

type Page = 'colors' | 'typography' | 'spacing' | 'radius' | 'shadows' | 'layout' | 'components' | 'architecture' | 'usage';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const navigation: { page: Page; label: string; path: string }[] = [
  { page: 'colors', label: '色彩', path: '#colors' },
  { page: 'typography', label: '字体', path: '#typography' },
  { page: 'spacing', label: '间距', path: '#spacing' },
  { page: 'radius', label: '圆角', path: '#radius' },
  { page: 'shadows', label: '阴影', path: '#shadows' },
  { page: 'layout', label: '布局', path: '#layout' },
  { page: 'components', label: '组件', path: '#components' },
  { page: 'architecture', label: '架构', path: '#architecture' },
  { page: 'usage', label: '使用', path: '#usage' },
];
const indexStep = 60;
const indexDuration = 280;
const accents = [
  { value: 'blue', label: '雾蓝' },
  { value: 'teal', label: '薄荷青' },
  { value: 'violet', label: '藤紫' },
  { value: 'rose', label: '玫瑰粉' },
];
---

<!doctype html>
<html lang="zh-CN" data-page="landing">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Luminedge 设计变量与组件展示。" />
    <title>{title} — Luminedge</title>
    <script define:vars={{ accentValues: accents.map(({ value }) => value) }}>
      (() => {
        const root = document.documentElement;
        const themeKey = 'luminedge-theme';
        const linesKey = 'luminedge-lines';
        const accentKey = 'luminedge-accent';
        function applyAccent(preference) {
          if (preference !== 'blue' && accentValues.includes(preference)) root.dataset.leAccent = preference;
          else delete root.dataset.leAccent;
          const picker = document.querySelector('[data-accent-picker]');
          if (picker) picker.value = root.dataset.leAccent || 'blue';
        }
        function applyTheme(preference) {
          if (preference === 'light' || preference === 'dark') root.dataset.leTheme = preference;
          else delete root.dataset.leTheme;
          const picker = document.querySelector('[data-theme-picker]');
          if (picker) picker.value = root.dataset.leTheme || 'system';
        }
        function applyLines(preference) {
          if (preference === 'off') root.dataset.leLines = 'off';
          else delete root.dataset.leLines;
          const picker = document.querySelector('[data-lines-picker]');
          if (picker) picker.value = root.dataset.leLines || 'on';
        }
        function restoreAppearance() {
          try {
            applyTheme(localStorage.getItem(themeKey));
            applyLines(localStorage.getItem(linesKey));
            applyAccent(localStorage.getItem(accentKey));
          } catch { /* Storage is optional. */ }
        }
        function save(key, value) {
          try {
            if (value === null) localStorage.removeItem(key);
            else localStorage.setItem(key, value);
          } catch { /* Keep the selection for this page. */ }
        }
        restoreAppearance();
        window.addEventListener('storage', (event) => {
          if ([themeKey, linesKey, accentKey, null].includes(event.key)) restoreAppearance();
        });
        window.addEventListener('pageshow', (event) => {
          if (event.persisted) restoreAppearance();
        });

        root.classList.add('has-js');
        document.addEventListener('DOMContentLoaded', () => {
          const picker = document.querySelector('[data-theme-picker]');
          const linesPicker = document.querySelector('[data-lines-picker]');
          const accentPicker = document.querySelector('[data-accent-picker]');
          accentPicker.value = root.dataset.leAccent || 'blue';
          picker.value = root.dataset.leTheme || 'system';
          linesPicker.value = root.dataset.leLines || 'on';
          picker.addEventListener('change', () => {
            applyTheme(picker.value);
            save(themeKey, picker.value === 'system' ? null : picker.value);
          });
          accentPicker.addEventListener('change', () => {
            applyAccent(accentPicker.value);
            save(accentKey, root.dataset.leAccent || null);
          });
          linesPicker.addEventListener('change', () => {
            applyLines(linesPicker.value);
            save(linesKey, root.dataset.leLines || null);
          });
          document.querySelector('[data-mobile-scroll-cue]')?.addEventListener('click', () => {
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            window.scrollBy({ top: window.innerHeight * 0.8, behavior: reduceMotion ? 'auto' : 'smooth' });
          });
        }, { once: true });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#colors">跳到主要内容</a>
    <div class="appearance-controls" role="group" aria-label="文档设置" hidden>
      <select class="le-select" data-lines-picker aria-label="强调线条">
        <option value="on">有线条</option>
        <option value="off">无线条</option>
      </select>
      <select class="le-select" data-accent-picker aria-label="主题色">
        {accents.map(({ value, label }) => <option value={value}>{label}</option>)}
      </select>
      <select class="le-select" data-theme-picker aria-label="外观主题">
        <option value="system">跟随系统</option>
        <option value="light">浅色</option>
        <option value="dark">深色</option>
      </select>
      <button class="le-button" type="button" data-subsection-search-open aria-label="搜索文档" aria-haspopup="dialog" aria-controls="subsection-search">
        <span>搜索<span class="appearance-search-long">文档</span></span>
      </button>
    </div>
    <header class="site-header" style={`--index-fade-duration: ${indexDuration}ms; --index-hide-delay: ${(navigation.length - 1) * indexStep + indexDuration}ms`}>
      <select class="mobile-index mobile-section-label" data-section-picker aria-label="章节">
        <option value="" hidden disabled selected>Luminedge</option>
        {navigation.map(({ page, label }) => <option value={page}>{label}</option>)}
      </select>
      <select class="mobile-index mobile-subsection-label" data-subsection-picker aria-label="章节内导航" hidden></select>
      <nav aria-label="页面导航">
        {navigation.map(({ page, label, path }, index) => (
          <a href={`${base}${path}`} data-index-target={page} style={`--index-delay: ${index * indexStep}ms; --index-exit-delay: ${(navigation.length - 1 - index) * indexStep}ms`}>{label}</a>
        ))}
      </nav>
    </header>

    <nav class="subsection-index" aria-label="章节内导航" data-subsection-index hidden>
      <div data-subsection-links></div>
    </nav>

    <dialog class="le-dialog subsection-search" id="subsection-search" data-subsection-search aria-label="搜索文档" closedby="any">
      <form>
        <label class="visually-hidden" for="subsection-search-query">搜索章节或组件</label>
        <input class="le-input" type="search" id="subsection-search-query" data-subsection-search-input placeholder="搜索章节或组件" autofocus />
      </form>
      <ul data-subsection-search-results></ul>
      <footer>
        <p class="subsection-search-status" role="status" data-subsection-search-status></p>
        <button class="le-button le-button--secondary" type="button" data-subsection-search-close>关闭</button>
      </footer>
    </dialog>

    <main id="top" class="landing-main" tabindex="-1">
      <slot />
    </main>
    <button class="mobile-scroll-cue" type="button" data-mobile-scroll-cue aria-label="向下滚动" hidden><span aria-hidden="true">↓</span></button>
    <script>
      import '../section-index';
    </script>
  </body>
</html>
