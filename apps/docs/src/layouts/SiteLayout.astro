---
import '../styles/tailwind.css';
import '../styles/site.css';

type Page = 'colors' | 'typography' | 'spacing' | 'radius' | 'shadows' | 'layout' | 'components' | 'architecture' | 'usage';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const navigation: { page: Page; label: string; path: string }[] = [
  { page: 'colors', label: '色彩', path: '#colors' },
  { page: 'typography', label: '字体', path: '#typography' },
  { page: 'spacing', label: '间距', path: '#spacing' },
  { page: 'radius', label: '圆角', path: '#radius' },
  { page: 'shadows', label: '阴影', path: '#shadows' },
  { page: 'layout', label: '布局', path: '#layout' },
  { page: 'components', label: '组件', path: '#components' },
  { page: 'architecture', label: '架构', path: '#architecture' },
  { page: 'usage', label: '使用', path: '#usage' },
];
const indexStep = 60;
const indexDuration = 280;
---

<!doctype html>
<html lang="zh-CN" data-page="landing">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Luminedge 设计变量与组件展示。" />
    <title>{title} — Luminedge</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeKey = 'luminedge-theme';
        const applyTheme = (preference) => {
          if (preference === 'light' || preference === 'dark') root.dataset.leTheme = preference;
          else delete root.dataset.leTheme;
          const picker = document.querySelector('[data-theme-picker]');
          if (picker) picker.value = root.dataset.leTheme || 'system';
        };
        try { applyTheme(localStorage.getItem(themeKey)); } catch { /* System colors also work without storage. */ }
        window.addEventListener('storage', (event) => {
          if (event.key === themeKey || event.key === null) {
            try { applyTheme(localStorage.getItem(themeKey)); } catch { /* Storage may be disabled. */ }
          }
        });

        let scheduled = false;
        let activeSection = '';

        const updateIndex = () => {
          root.classList.toggle('index-visible', window.scrollY > 24);
          const cue = document.querySelector('[data-mobile-scroll-cue]');
          if (cue) cue.hidden = window.scrollY + window.innerHeight >= root.scrollHeight - 1;

          const center = window.innerHeight / 2;
          const section = Array.from(document.querySelectorAll('[data-index-section]')).find((element) => {
            const bounds = element.getBoundingClientRect();
            return bounds.top <= center && bounds.bottom > center;
          });
          const currentSection = section?.id || '';
          if (currentSection === activeSection) return;
          activeSection = currentSection;
          let label = 'Luminedge';
          document.querySelectorAll('[data-index-target]').forEach((link) => {
            if (activeSection && link.getAttribute('data-index-target') === activeSection) {
              link.setAttribute('aria-current', 'location');
              label = link.textContent?.trim() || label;
            } else {
              link.removeAttribute('aria-current');
            }
          });
          const currentLabel = document.querySelector('[data-current-section]');
          if (currentLabel) currentLabel.textContent = label;
        };

        const scheduleUpdate = () => {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(() => {
            scheduled = false;
            updateIndex();
          });
        };

        root.classList.add('has-js');
        window.addEventListener('scroll', scheduleUpdate, { passive: true });
        window.addEventListener('resize', scheduleUpdate, { passive: true });
        window.addEventListener('pageshow', scheduleUpdate);
        document.addEventListener('DOMContentLoaded', () => {
          const picker = document.querySelector('[data-theme-picker]');
          picker.value = root.dataset.leTheme || 'system';
          picker.hidden = false;
          picker.addEventListener('change', () => {
            applyTheme(picker.value);
            try {
              if (picker.value === 'system') localStorage.removeItem(themeKey);
              else localStorage.setItem(themeKey, picker.value);
            } catch { /* Keep the selection for this page. */ }
          });
          document.querySelector('[data-mobile-scroll-cue]')?.addEventListener('click', () => {
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            window.scrollBy({ top: window.innerHeight * 0.8, behavior: reduceMotion ? 'auto' : 'smooth' });
          });
          updateIndex();
        }, { once: true });
        updateIndex();
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#colors">跳到主要内容</a>
    <select class="theme-picker" data-theme-picker aria-label="外观主题" hidden>
      <option value="system">跟随系统</option>
      <option value="light">浅色</option>
      <option value="dark">深色</option>
    </select>
    <header class="site-header" style={`--index-fade-duration: ${indexDuration}ms; --index-hide-delay: ${(navigation.length - 1) * indexStep + indexDuration}ms`}>
      <span class="mobile-section-label" data-current-section>Luminedge</span>
      <nav aria-label="页面导航">
        {navigation.map(({ page, label, path }, index) => (
          <a href={`${base}${path}`} data-index-target={page} style={`--index-delay: ${index * indexStep}ms; --index-exit-delay: ${(navigation.length - 1 - index) * indexStep}ms`}>{label}</a>
        ))}
      </nav>
    </header>

    <main id="top" class="landing-main" tabindex="-1">
      <slot />
    </main>
    <button class="mobile-scroll-cue" type="button" data-mobile-scroll-cue aria-label="向下滚动" hidden><span aria-hidden="true">↓</span></button>
  </body>
</html>
