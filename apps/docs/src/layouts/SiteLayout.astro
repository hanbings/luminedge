---
import { docHref } from '../doc-catalog';
import AppearanceControls from './AppearanceControls.astro';
import SectionNavigation from './SectionNavigation.astro';
import SiteFrame from './SiteFrame.astro';
import SiteSearch from './SiteSearch.astro';

interface Props {
  title: string;
  navigation: { anchor: string; title: string }[];
  docLinks: Record<string, string>;
}

const { title, navigation, docLinks } = Astro.props;
---

<SiteFrame title={title} page="landing">
  <a class="skip-link" href={navigation[0] ? `#${navigation[0].anchor}` : '#top'}>跳到主要内容</a>
  <AppearanceControls hidden>
    <a class="le-button le-button--secondary" href={docHref('index')} data-showcase-doc-link data-doc-links={JSON.stringify(docLinks)} aria-label="阅读文档"><span class="appearance-search-long">阅读</span>文档</a>
  </AppearanceControls>
  <SectionNavigation chapters={navigation} />

  <SiteSearch placeholder="搜索章节或组件" />

  <main id="top" class="landing-main" tabindex="-1">
    <slot />
  </main>
  <button class="mobile-scroll-cue" type="button" data-mobile-scroll-cue aria-label="向下滚动" hidden><span aria-hidden="true">↓</span></button>
  <script>
    import '../section-index';
  </script>
</SiteFrame>
