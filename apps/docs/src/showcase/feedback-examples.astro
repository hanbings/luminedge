---
import Demo from './Demo.astro';
---

<Demo id="alert" title="提示信息" alias="catalog-feedback">
  <div class="component-demo-stack">
    <div class="le-alert">有一条新的提示。</div>
    <div class="le-alert le-alert--secondary">发现一个值得留意的灵感。</div>
    <div class="le-alert le-alert--success">内容已保存。</div>
    <div class="le-alert le-alert--warning">还有一项内容需要留意。</div>
    <div class="le-alert le-alert--danger">暂时无法完成操作。</div>
  </div>
</Demo>

<Demo id="tag" title="标签">
  <div class="component-demo-inline">
    <span class="le-tag">灵感</span>
    <span class="le-tag le-tag--secondary">收藏</span>
    <span class="le-tag le-tag--success">已完成</span>
    <span class="le-tag le-tag--warning">待处理</span>
  </div>
</Demo>

<Demo id="badge" title="徽标">
  <div class="component-demo-inline">
    <span class="le-badge" aria-label="3 条未读消息">3</span>
    <span class="le-badge le-badge--secondary" aria-label="2 条收藏">2</span>
  </div>
</Demo>

<Demo id="progress" title="进度条">
  <div class="component-demo-stack">
    <div class="le-field">
      <label class="le-label" for="demo-progress">整理进度 <span aria-hidden="true">· 60%</span></label>
      <progress class="le-progress" id="demo-progress" value="60" max="100">60%</progress>
    </div>
  </div>
</Demo>

<Demo id="spinner" title="加载指示器">
  <div class="component-demo-inline"><span class="le-spinner" aria-hidden="true"></span><span>正在加载</span></div>
</Demo>

<Demo id="meter" title="计量条">
  <div class="le-field">
    <label class="le-label" for="demo-meter">空间占用 <span aria-hidden="true">· 6 / 10 GB</span></label>
    <meter class="le-meter" id="demo-meter" min="0" max="10" value="6">6 / 10 GB</meter>
  </div>
</Demo>

<Demo id="toast" title="消息通知">
  <div class="component-demo-stack" id="component-example-app">
    <button class="le-button component-demo-button" type="button" data-show-toast>显示通知</button>
    <div class="le-toast-region" data-le-app-notifications role="status" aria-live="polite" aria-atomic="false"></div>
  </div>
</Demo>

<Demo id="empty" title="空状态">
  <div class="le-empty">
    <strong class="le-empty-title">还没有收藏</strong>
    <p>收藏的记录会显示在这里。</p>
  </div>
</Demo>

<Demo id="skeleton" title="骨架屏">
  <div class="component-demo-stack" role="group" aria-busy="true" aria-label="正在加载记录">
    <span class="le-skeleton" aria-hidden="true" style="--le-skeleton-width: 9rem"></span>
    <span class="le-skeleton" aria-hidden="true" style="--le-skeleton-width: 18rem"></span>
    <span class="le-skeleton" aria-hidden="true" style="--le-skeleton-width: 13rem"></span>
  </div>
</Demo>

<script>
  import { createApp, type ToastController } from '@luminedge/ui';

  const demo = document.querySelector<HTMLElement>('#component-example-toast');
  if (demo) {
    const app = createApp(demo);
    let current: ToastController | undefined;
    demo.querySelector('[data-show-toast]')?.addEventListener('click', () => {
      current?.dismiss();
      current = app.notify({ message: '内容已保存。', variant: 'success' });
    });
  }
</script>
