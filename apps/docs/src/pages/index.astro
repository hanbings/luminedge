---
import SiteLayout from '../layouts/SiteLayout.astro';
import { mascotLogo } from '../branding';
import Colors from '../sections/colors.astro';
import Typography from '../sections/typography.astro';
import Layout from '../sections/layout.astro';
import Spacing from '../sections/spacing.astro';
import Radius from '../sections/radius.astro';
import Shadows from '../sections/shadows.astro';
import Components from '../sections/components.astro';
import Usage from '../sections/usage.astro';
---

<SiteLayout title="设计与组件">
  <div class="landing-cover">
    <h1 class="visually-hidden">Luminedge</h1>
    <div class="hero-visual">
      <img src={mascotLogo} alt="Luminedge 吉祥物与品牌标志" width="1920" height="1080" />
    </div>
    <a class="scroll-cue" href="#colors" aria-label="查看色彩"><span aria-hidden="true">↓</span></a>
  </div>

  <Colors />
  <Typography />
  <Layout />
  <Spacing />
  <Radius />
  <Shadows />
  <Components />
  <Usage />
</SiteLayout>
