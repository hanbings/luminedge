---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { docSlug, getDocEntries } from '../../doc-catalog';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getShowcaseChapters, getShowcaseSubsections } from '../../showcase/index-data';

export const getStaticPaths = (async () => {
  const entries = await getDocEntries();
  const chapters = getShowcaseChapters(entries);
  const subsectionIndex = await getShowcaseSubsections(chapters);
  return entries.map((entry) => ({
    params: { slug: docSlug(entry.id) },
    props: { entry, entries, chapters, subsectionIndex },
  }));
}) satisfies GetStaticPaths;

const { entry, entries, chapters, subsectionIndex } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout {entry} {entries} {chapters} {subsectionIndex} {headings}>
  <Content />
</DocsLayout>
