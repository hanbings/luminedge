---
import TokenValue from './TokenValue.astro';

const shadows = [
  { name: '无', token: '--le-shadow-none' },
  { name: '轻', token: '--le-shadow-sm' },
  { name: '中', token: '--le-shadow-md' },
  { name: '浮层', token: '--le-shadow-lg' },
];

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="section landing-content" id="shadows" data-index-section aria-labelledby="shadows-title" tabindex="-1">
  <div class="section-content">
    <div class="section-heading">
      <h2 id="shadows-title">{title}</h2>
    </div>

    <div class="foundation-grid">
      {shadows.map(({ name, token }) => (
        <div class="foundation-tile">
          <div class="shadow-stage"><div class="shadow-sample" style={`box-shadow: var(${token})`}></div></div>
          <strong>{name}</strong>
          <code>{token}</code>
          <TokenValue token={token} />
        </div>
      ))}
    </div>
  </div>
</section>
