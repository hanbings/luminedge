---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="section landing-content ending-section" id="usage" data-index-section aria-labelledby="usage-title" tabindex="-1">
  <div class="section-content usage">
    <div>
      <h2 id="usage-title">{title}</h2>
      <p>样式与交互可以独立使用。</p>
    </div>
    <div class="code-card">
      <div class="code-label"><span>统一入口</span><span>JAVASCRIPT</span></div>
      <pre><code>import '@luminedge/ui/styles.css';
import &#123; createDialog &#125; from '@luminedge/ui';</code></pre>
    </div>
  </div>
  <footer class="site-footer"><span>Natural, friendly, elegant.</span></footer>
</section>
